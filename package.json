{
  "name": "dish-covery",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "server": "json-server --watch src/assets/db.json --port 3000",
    "audit:ci": "yarn audit --level high",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
